@using System.Dynamic
@model List<ExpandoObject>

<div id="root">
    <ul class="nav nav-tabs nav-tabs-light mb-4">
        <li class="nav-item"><a class="nav-link active" href="#">New</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Used</a></li>
    </ul>
    <form class="form-group form-group-light d-block">
        <div class="row g-0 ms-lg-n2">
            <div class="col-lg-2">
                <div class="input-group border-end-lg border-light">
                    <span class="input-group-text text-muted ps-2 ps-sm-3">
                        <i class="fi-search"></i>
                    </span>
                    <input class="form-control" placeholder="Keywords..." type="text" name="keywords">
                </div>
            </div>
            <hr class="hr-light d-lg-none my-2">
            @foreach (dynamic dropdown in Model) // Use dynamic
            {
                <div class="col-lg-2 col-md-3 col-sm-6">
                    <div class="dropdown border-end-sm border-light">
                        <button class="btn btn-link dropdown-toggle ps-2 ps-sm-3" type="button">
                            <i class="@dropdown.Icon me-2"></i>
                            <span class="dropdown-toggle-label">@dropdown.Name</span>
                        </button>
                        <input type="hidden" name="@dropdown.Name.ToLower()">
                        <ul class="dropdown-menu dropdown-menu-dark">
                            @foreach (var option in dropdown.Options)
                            {
                                <li><a class="dropdown-item" href="#"><span class="dropdown-item-label">@option.Name</span></a></li>
                            }
                        </ul>
                    </div>
                </div>
            }
            <hr class="hr-light d-lg-none my-2">
            <div class="col-lg-2">
                <button class="btn btn-primary w-100" type="button">Search</button>
            </div>
        </div>
    </form>
</div>